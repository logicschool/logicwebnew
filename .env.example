NODE_ENV=development
PORT=8080
HOST=127.0.0.1
PUBLIC_ORIGIN=http://127.0.0.1:8080
# Use individual fields to avoid URL-encoding special characters in passwords.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=logic
PGUSER=logic
PGPASSWORD=CHANGE_ME
# Alternative: DATABASE_URL=postgresql://logic:URL_ENCODED_PASSWORD@127.0.0.1:5432/logic
# If DATABASE_URL is set, it takes precedence over the fields above.
PGSSL=false
# For AWS RDS TLS: PGSSL=true and the path to its trusted CA certificate.
# PGSSLROOTCERT=/absolute/path/to/rds-ca-bundle.pem
# Do not combine PGSSL with sslmode/sslrootcert parameters in DATABASE_URL.
# Set to 1 ONLY if precisely one trusted reverse proxy is in front of Node.
TRUST_PROXY=
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Secrets override protected integration configuration. Keep out of Git.
ODOO_API_KEY=
CRM_WEBHOOK_SECRET=
# Set temporarily for npm run admin:create, then remove ADMIN_PASSWORD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
